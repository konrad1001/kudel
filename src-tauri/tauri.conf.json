{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "strudel-studio",
  "version": "0.1.0",
  "identifier": "dev.konrad.strudel-studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Strudel Studio",
        "width": 1200,
        "height": 700,
        "center": true,
        "dragDropEnabled": false,
        "theme": "Dark",
        "backgroundColor": "#0c0c0c"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-eval' data:",
        "style-src": "'self' 'unsafe-inline'",
        "connect-src": "'self' ipc: http://ipc.localhost asset: http://asset.localhost https://strudel.b-cdn.net https://felixroos.github.io https://raw.githubusercontent.com",
        "media-src": "'self' asset: http://asset.localhost",
        "img-src": "'self' data:"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-eval' 'unsafe-inline' data:",
        "style-src": "'self' 'unsafe-inline'",
        "connect-src": "'self' ipc: http://ipc.localhost ws://localhost:1420 asset: http://asset.localhost https://strudel.b-cdn.net https://felixroos.github.io https://raw.githubusercontent.com",
        "media-src": "'self' asset: http://asset.localhost",
        "img-src": "'self' data:"
      },
      "dangerousDisableAssetCspModification": ["script-src", "style-src"],
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
